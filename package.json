{
  "name": "pdfshub",
  "version": "1.0.0",
  "description": "PDFHub — 33 Free Browser-Based PDF Tools",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "validate:assets": "node scripts/validate-deployment-assets.mjs",
    "test:pwa": "node scripts/test-pwa-suite.mjs",
    "test:tools": "node scripts/test-pdf-tools-e2e.mjs",
    "test:passwords": "node scripts/test-password-protected-pdfs.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "test:guides": "node scripts/verify-guides.mjs",
    "capture:guides": "node scripts/capture-tool-guides.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "build:seo": "node scripts/build-seo-suite.mjs && node scripts/generate-sitemap.mjs",
    "build:docs": "node scripts/build-docs-suite.mjs && node scripts/build-core-docs.mjs && node scripts/build-docs-html.mjs",
    "test:docs": "node scripts/test-docs-portal.mjs",
    "test:docs-mobile": "node scripts/test-docs-mobile-and-support.mjs",
    "test:docs-desktop": "node scripts/test-desktop-docs-menu.mjs",
    "test:terms": "node scripts/verify-privacy-and-terms.mjs && node scripts/test-sticky-mobile-terms.mjs",
    "test:floating": "node scripts/test-floating-controls-e2e.mjs",
    "test:footer": "node scripts/verify-footer-ui-e2e.mjs",
    "test:social": "node scripts/test-social-preview.mjs",
    "test:theme": "node scripts/test-theme-consistency-e2e.mjs",
    "test:reveal": "node scripts/test-circular-theme-reveal.mjs",
    "test:menu-search": "node scripts/test-toolbar-search-and-menu.mjs",
    "test:live-preview": "node scripts/verify-live-production-preview.mjs",
    "audit:domain": "node scripts/audit-domain-references.mjs && node scripts/check-dist-domain.mjs"
  },
  "devDependencies": {
    "docx": "^9.11.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "wrangler": "^4.151.1",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "pdf-lib-encrypt": "^1.0.3"
  }
}
