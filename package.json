{
  "name": "pdfshub",
  "version": "1.0.0",
  "description": "PDFHub — 33 Free Browser-Based PDF Tools",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "validate:assets": "node scripts/validate-deployment-assets.mjs",
    "test:pwa": "node scripts/test-pwa-suite.mjs",
    "test:tools": "node scripts/test-pdf-tools-e2e.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "test:guides": "node scripts/verify-guides.mjs",
    "capture:guides": "node scripts/capture-tool-guides.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "build:seo": "node scripts/build-seo-suite.mjs && node scripts/generate-sitemap.mjs",
    "build:docs": "node scripts/build-docs-suite.mjs && node scripts/build-core-docs.mjs && node scripts/build-docs-html.mjs",
    "test:docs": "node scripts/test-docs-portal.mjs"
  },
  "devDependencies": {
    "docx": "^9.11.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "wrangler": "^4.151.1",
    "xlsx": "^0.18.5"
  }
}
